+/// The machine's name for the status row: the host name up to its first
+/// dot, at most 20 characters, upper case ("Mikes-MacBook-Pro.local" →
+/// "MIKES-MACBOOK-PRO").
+String shortHostName(String hostname) {
+  final short = hostname.split('.').first.trim();
+  final name = short.isEmpty ? 'LOCALHOST' : short.toUpperCase();
+  return name.length > 20 ? name.substring(0, 20) : name;
 }
 
+/// The splash car. Every row is a mirror image of itself (with `/` and
+/// `\`, `[` and `]`, `(` and `)` swapped; the badge text reads normally).
+List<String> buildSplashCarArt() => const [
+  r'    /\                                             /\    ',
+  r'   /  \_________                         _________/  \   ',
+  r'  /   /         \                       /         \   \  ',
+  r' /   /           \                     /           \   \ ',
+  r'/___/             \                   /             \___\',
+  r'    \              \_________________/              /    ',
+  r'     \_____   _____________________________   _____/     ',
+  r'          \ [                               ] /          ',
+  r'      ___  \[                               ]/  ___      ',
+  r'     /   \  |  ===========================  |  /   \     ',
+  r'    | [=] | | [■ ■]      | DMC |      [■ ■] | | [=] |    ',
+  r'     \___/  |_______|_______________|_______|  \___/     ',
+  r'            (O)                           (O)            ',
+  r'             \=============================/             ',
+];
+
 void _rule(Console console, int row, int width, ConsoleColor color) =>
     _at(console, row, 0, '─' * width, fg: color, maxWidth: width);
 
