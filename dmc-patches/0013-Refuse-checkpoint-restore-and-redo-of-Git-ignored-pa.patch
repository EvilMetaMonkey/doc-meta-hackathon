+            'git_ignored',
+            'Git ignores this path now. Restore and redo never create, overwrite or delete a Git-ignored file.',
+            path: file.filePath,
+          ),
+        );
+        continue;
+      }
       if (intendedKind == CheckpointFileKind.file) {
         final problem = _verifySnapshot(
           file.filePath,
