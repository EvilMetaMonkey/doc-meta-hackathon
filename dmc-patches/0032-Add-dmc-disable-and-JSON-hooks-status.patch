@@ -0,0 +1,224 @@
+import 'dart:async';
+import 'dart:convert';
+import 'dart:io';
+
+import 'package:dmc/dmc.dart';
+import 'package:path/path.dart' as p;
+import 'package:test/test.dart';
+
+const dmcCommand = '/opt/dmc/bin/dmc';
+
+void main() {
+  late Directory sandbox;
+  late Directory root;
+  late Directory home;
+
+  setUp(() async {
+    sandbox = Directory.systemTemp.createTempSync('dmc_disable_');
+    root = Directory(p.join(sandbox.path, 'project'))..createSync();
+    home = Directory(p.join(sandbox.path, 'home'))..createSync();
+    await initDmc(basePath: root.path);
+  });
+
+  tearDown(() {
+    if (sandbox.existsSync()) sandbox.deleteSync(recursive: true);
+  });
+
+  Future<({int code, List<String> output})> capture(
+    Future<int> Function() body,
+  ) async {
+    final output = <String>[];
+    final code = await runZoned(
+      body,
+      zoneSpecification: ZoneSpecification(
+        print: (_, _, _, message) => output.add(message),
+      ),
+    );
+    return (code: code, output: output);
+  }
+
+  Future<int> install(String agent, {String command = dmcCommand}) async =>
+      (await capture(
+        () => runHooksCommand(
+          action: 'install',
+          agentName: agent,
+          apply: true,
+          dmcCommand: command,
+          currentDirectory: root.path,
+          homePath: home.path,
+        ),
+      )).code;
+
+  Future<({int code, List<String> output})> disable({
+    bool apply = false,
+    bool json = false,
+  }) => capture(
+    () => runDisableCommand(
+      apply: apply,
+      json: json,
+      requestedSchemaVersion: json ? '1' : null,
+      currentDirectory: root.path,
+      homePath: home.path,
+    ),
+  );
+
+  File claudeLocal() =>
+      File(p.join(root.path, '.claude', 'settings.local.json'));
+  File museUser() =>
+      File(p.join(home.path, '.config', 'muse', 'settings.json'));
+
+  /// Every file under .dmc with its bytes: history and checkpoints.
+  Map<String, String> vault() => {
+    for (final entity in Directory(
+      p.join(root.path, '.dmc'),
+    ).listSync(recursive: true))
+      if (entity is File)
+        p.relative(entity.path, from: root.path): base64Encode(
+          entity.readAsBytesSync(),
+        ),
+  };
+
+  // Another tool's hooks, and Muse settings that are not hooks.
+  const museOriginal =
+      '{\n    "model": "muse-wonder-1.0",\n    "hooks": {\n        "Stop": [\n            {\n                "matcher": "*",\n                "hooks": [\n                    {\n                        "type": "command",\n                        "command": "echo other-tool"\n                    }\n                ]\n            }\n        ]\n    }\n}\n';
+
+  test(
+    'preview lists only dmc hooks and changes nothing; apply removes '
+    'them, keeps other hooks, restores the bytes and keeps history',
+    () async {
+      museUser()
+        ..createSync(recursive: true)
+        ..writeAsStringSync(museOriginal);
+      expect(await install('claude-code'), 0);
+      expect(await install('muse-code'), 0);
+      // A hook from another dmc build in the same file.
+      final claude =
+          jsonDecode(claudeLocal().readAsStringSync()) as Map<String, Object?>;
+      ((claude['hooks'] as Map)['Stop'] as List).add({
+        'matcher': '*',
+        'hooks': [
+          {
+            'type': 'command',
+            'command': '/old/dmc agent-hook claude-code Stop',
+          },
+        ],
+      });
+      claudeLocal().writeAsStringSync(
+        const JsonEncoder.withIndent('  ').convert(claude),
+      );
+      final service = CheckpointService(
+        basePath: root.path,
+        homePath: home.path,
+      );
+      final begin = await service.begin(label: 'kept');
+      File(p.join(root.path, 'a.txt')).writeAsStringSync('a');
+      await service.close(((begin.data['checkpoint'] as Map)['id']) as String);
+      final history = vault();
+      final claudeBefore = claudeLocal().readAsStringSync();
+      final museBefore = museUser().readAsStringSync();
+
+      final preview = await disable();
+      expect(preview.code, 0, reason: preview.output.join('\n'));
+      final text = preview.output.join('\n');
+      expect(text, contains('Claude Code (local): ${claudeLocal().path}'));
+      expect(
+        text,
+        contains('  - Stop: $dmcCommand agent-hook claude-code Stop'),
+      );
+      expect(text, contains('  - Stop: /old/dmc agent-hook claude-code Stop'));
+      expect(text, contains('Muse Code (user): ${museUser().path}'));
+      expect(
+        text,
+        contains('  - Interrupt: $dmcCommand agent-hook muse-code Interrupt'),
+      );
+      expect(text, contains('serve every dmc workspace'));
+      expect(text, contains('Watcher: not running'));
+      expect(text, isNot(contains('echo other-tool')));
+      expect(text, contains('Preview only'));
+      expect(claudeLocal().readAsStringSync(), claudeBefore);
+      expect(museUser().readAsStringSync(), museBefore);
+
+      final applied = await disable(apply: true);
+      expect(applied.code, 0, reason: applied.output.join('\n'));
+      // dmc created the Claude file, so it goes; Muse's is back to its bytes.
+      expect(claudeLocal().existsSync(), isFalse);
+      expect(museUser().readAsStringSync(), museOriginal);
+      expect(applied.output.join('\n'), contains('dmc hooks install'));
+      // History and checkpoints are untouched.
+      expect(vault(), history);
+      expect((await service.list()).data['checkpoints'], hasLength(1));
+
+      // Idempotent.
+      final again = await disable(apply: true);
+      expect(again.code, 0);
+      expect(again.output.join('\n'), contains('Nothing to disable.'));
+      expect(museUser().readAsStringSync(), museOriginal);
+      expect(vault(), history);
+    },
+  );
+
+  test('--json reports the hooks, the watcher and the kept history', () async {
+    expect(await install('claude-code'), 0);
+    final preview = await disable(json: true);
+    expect(preview.code, 0);
+    final envelope = jsonDecode(preview.output.single) as Map;
+    expect(envelope['command'], 'disable');
+    expect(envelope['schemaVersion'], 1);
+    final data = envelope['data'] as Map;
+    expect(data['mode'], 'preview');
+    expect((data['hooks'] as List).map((h) => (h as Map)['event']), [
+      'UserPromptSubmit',
+      'Stop',
+      'StopFailure',
+      'SessionEnd',
+    ]);
+    expect((data['hooks'] as List).first, containsPair('agent', 'claude-code'));
+    expect(data['watcher'], {'running': false, 'stopped': false});
+    expect(data['historyKept'], isTrue);
+    expect(claudeLocal().existsSync(), isTrue);
+
+    final applied = await disable(json: true, apply: true);
+    final appliedData =
+        (jsonDecode(applied.output.single) as Map)['data'] as Map;
+    expect(appliedData['mode'], 'apply');
+    expect(appliedData['removedConfigFiles'], [claudeLocal().path]);
+    expect(claudeLocal().existsSync(), isFalse);
+  });
+
+  test('outside a workspace only user-scope hooks are checked', () async {
+    expect(await install('muse-code'), 0);
+    final outside = Directory(p.join(sandbox.path, 'elsewhere'))..createSync();
+    final result = await capture(
+      () => runDisableCommand(
+        apply: true,
+        currentDirectory: outside.path,
+        homePath: home.path,
+      ),
+    );
+    expect(result.code, 0);
+    expect(result.output.join('\n'), contains('only user-scope hooks'));
+    expect(museUser().existsSync(), isFalse);
+  });
+
+  test('hooks status --json reports each event', () async {
+    expect(await install('claude-code'), 0);
+    final result = await capture(
+      () => runHooksCommand(
+        action: 'status',
+        agentName: 'claude-code',
+        dmcCommand: dmcCommand,
+        currentDirectory: root.path,
+        homePath: home.path,
+        json: true,
+        requestedSchemaVersion: '1',
+      ),
+    );
+    expect(result.code, 0);
+    final data = (jsonDecode(result.output.single) as Map)['data'] as Map;
+    expect(data['agent'], 'claude-code');
+    expect(data['scope'], 'local');
+    expect(data['installed'], isTrue);
+    expect((data['events'] as Map)['Stop'], isTrue);
+    expect(data['otherDmcCommands'], isEmpty);
+  });
+}
