diff --git a/lib/src/hook_report.dart b/lib/src/hook_report.dart
new file mode 100644
index 0000000000000000000000000000000000000000..b4987af546e85b642fe55d8098550553fc758bd2
--- /dev/null
+++ b/lib/src/hook_report.dart
@@ -0,0 +1,185 @@
+import 'dart:convert';
+import 'dart:io';
+
+import 'package:path/path.dart' as p;
+
+import 'agent_hooks.dart';
+import 'hook_installer.dart';
+
+/// dmc's hook entries wherever the installer can write them: used by
+/// `dmc disable` and `dmc doctor`. Read-only, apart from
+/// [writeHookConfigFile].
+
+/// One hook config file the installer supports.
+class HookLocation {
+  final HookAgent agent;
+  final HookScope scope;
+  final String path;
+
+  const HookLocation(this.agent, this.scope, this.path);
+}
+
+/// Every (agent, scope) config file the installer supports. Workspace
+/// scopes are included only when [workspaceRoot] is known.
+List<HookLocation> hookLocations({
+  required String? workspaceRoot,
+  required String homePath,
+}) => [
+  for (final agent in HookAgent.values)
+    for (final scope in HookScope.values)
+      if (workspaceRoot != null || scope == HookScope.user)
+        if (hookConfigPath(
+              agent,
+              scope,
+              workspaceRoot: workspaceRoot,
+              homePath: homePath,
+            )
+            case final path?)
+          HookLocation(agent, scope, path),
+];
+
+/// A hook config file as read: its text and JSON, or why it could not be
+/// used.
+class HookConfigFile {
+  final HookLocation location;
+  final bool exists;
+  final String text;
+  final Map<String, Object?>? config;
+  final String? error;
+
+  const HookConfigFile(
+    this.location, {
+    required this.exists,
+    required this.text,
+    this.config,
+    this.error,
+  });
+}
+
+HookConfigFile readHookConfigFile(HookLocation location) {
+  final file = File(location.path);
+  if (!file.existsSync()) {
+    return HookConfigFile(location, exists: false, text: '', config: {});
+  }
+  final text = file.readAsStringSync();
+  try {
+    final decoded = text.trim().isEmpty
+        ? <String, Object?>{}
+        : jsonDecode(text);
+    if (decoded is! Map<String, Object?>) {
+      return HookConfigFile(
+        location,
+        exists: true,
+        text: text,
+        error: 'not a JSON object',
+      );
+    }
+    return HookConfigFile(location, exists: true, text: text, config: decoded);
+  } on FormatException catch (error) {
+    return HookConfigFile(
+      location,
+      exists: true,
+      text: text,
+      error: 'not valid JSON (${error.message})',
+    );
+  }
+}
+
+/// One dmc-owned handler: a command of the form
+/// `<dmc command> agent-hook <agent> <event>` under that event.
+class DmcHookEntry {
+  final HookLocation location;
+  final String event;
+  final String command;
+
+  /// The part before ` agent-hook`: the dmc that the hook runs.
+  final String dmcCommand;
+  final bool async;
+
+  const DmcHookEntry({
+    required this.location,
+    required this.event,
+    required this.command,
+    required this.dmcCommand,
+    required this.async,
+  });
+
+  Map<String, Object?> toJson() => {
+    'agent': location.agent.id,
+    'scope': location.scope.name,
+    'configPath': location.path,
+    'event': event,
+    'command': command,
+    'dmcCommand': dmcCommand,
+    'async': async,
+  };
+}
+
+/// dmc's own handlers in [file]: commands that end in
+/// ` agent-hook <this agent> <this event>`. Other tools' hooks never match.
+List<DmcHookEntry> dmcHookEntries(HookConfigFile file) {
+  final hooks = file.config?['hooks'];
+  if (hooks is! Map<String, Object?>) return const [];
+  final agent = file.location.agent;
+  final entries = <DmcHookEntry>[];
+  for (final event in hooks.entries) {
+    final groups = event.value;
+    if (groups is! List<Object?>) continue;
+    final suffix = ' agent-hook ${agent.id} ${event.key}';
+    for (final group in groups) {
+      if (group is! Map<String, Object?>) continue;
+      final handlers = group['hooks'];
+      if (handlers is! List<Object?>) continue;
+      for (final handler in handlers.whereType<Map<String, Object?>>()) {
+        final command = handler['command'];
+        if (command is! String || !command.endsWith(suffix)) continue;
+        final dmcCommand = command
+            .substring(0, command.length - suffix.length)
+            .trim();
+        if (dmcCommand.isEmpty) continue;
+        entries.add(
+          DmcHookEntry(
+            location: file.location,
+            event: event.key,
+            command: command,
+            dmcCommand: dmcCommand,
+            async: handler['async'] == true,
+          ),
+        );
+      }
+    }
+  }
+  return entries;
+}
+
+/// The executable a hook's dmc command runs, when it is one (possibly
+/// single-quoted) path; null for commands such as `dart run …/dmc.dart`.
+String? hookExecutablePath(String dmcCommand) {
+  final text = dmcCommand.trim();
+  if (text.startsWith("'") && text.endsWith("'") && text.length > 1) {
+    return text.substring(1, text.length - 1).replaceAll("'\\''", "'");
+  }
+  if (text.contains(' ')) return null;
+  return text;
+}
+
+/// The command this dmc writes into hooks (as `dmc hooks install` does).
+String currentHookCommand({String? executable}) => shellQuote(
+  p.normalize(p.absolute(executable ?? Platform.resolvedExecutable)),
+);
+
+/// Write [after] for [file] in its original layout; a config left empty is
+/// one dmc created, so the file is removed. Returns true when it was removed.
+bool writeHookConfigFile(HookConfigFile file, Map<String, Object?> after) {
+  final target = File(file.location.path);
+  if (after.isEmpty) {
+    if (target.existsSync()) target.deleteSync();
+    return true;
+  }
+  final text = encodeHookConfig(after, original: file.text);
+  target.parent.createSync(recursive: true);
+  final temporary = File('${file.location.path}.dmc-tmp');
+  temporary.writeAsStringSync(text, flush: true);
+  temporary.renameSync(file.location.path);
+  return false;
+}
diff --git a/test/disable_test.dart b/test/disable_test.dart
new file mode 100644
index 0000000000000000000000000000000000000000..0118228dd9b8049feab9423784463af9a4727fbe
