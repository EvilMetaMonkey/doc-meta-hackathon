diff --git a/lib/src/disable.dart b/lib/src/disable.dart
new file mode 100644
index 0000000000000000000000000000000000000000..2c66294c9d290395ccf3cbd15f5114502d0e8cb7
--- /dev/null
+++ b/lib/src/disable.dart
@@ -0,0 +1,186 @@
+import 'dart:io';
+
+import 'agent_hooks.dart';
+import 'daemon.dart';
+import 'hook_installer.dart';
+import 'hook_report.dart';
+import 'machine_output.dart';
+import 'watcher_control.dart';
+import 'workspace.dart';
+
+/// `dmc disable [--apply] [--json --schema-version 1]`: remove only dmc's
+/// own agent hooks and stop the watcher. Code, history (`.dmc/` and every
+/// checkpoint) and other tools' hooks are untouched.
+///
+/// Every config file the installer supports is checked: the workspace's
+/// project and local files and the user files. User-scope hooks serve every
+/// dmc workspace, so removing them disables recording in all of them. Each
+/// dmc command found (this build or another) is removed with the installer's
+/// exact-match uninstall, and the file is written back in its original
+/// layout (removed if dmc created it). Preview by default.
+Future<int> runDisableCommand({
+  bool apply = false,
+  bool json = false,
+  String? requestedSchemaVersion,
+  String? currentDirectory,
+  String? homePath,
+}) async {
+  final cwd = currentDirectory ?? Directory.current.path;
+  final schemaFailure = validateMachineSchemaRequest(
+    'disable',
+    requestedSchemaVersion,
+    json: json,
+  );
+  if (schemaFailure != null) {
+    if (json) {
+      print(schemaFailure.withWorkspace(cwd).encode());
+    } else {
+      print('[DMC] Error: ${schemaFailure.errors.single.message}');
+    }
+    return schemaFailure.exitCode;
+  }
+  final home =
+      homePath ??
+      Platform.environment['HOME'] ??
+      Platform.environment['USERPROFILE'];
+  if (home == null) {
+    return _fail(json, cwd, 'home_unknown', 'Cannot find the home directory.');
+  }
+  final root = findDmcWorkspace(cwd);
+
+  final removed = <DmcHookEntry>[];
+  final problems = <MachineMessage>[];
+  final writes = <(HookConfigFile, Map<String, Object?>)>[];
+  for (final location in hookLocations(workspaceRoot: root, homePath: home)) {
+    final file = readHookConfigFile(location);
+    if (!file.exists) continue;
+    if (file.error != null) {
+      problems.add(
+        MachineMessage(
+          'hook_config_unreadable',
+          '${location.path} is ${file.error}; it was left alone.',
+        ),
+      );
+      continue;
+    }
+    final entries = dmcHookEntries(file);
+    if (entries.isEmpty) continue;
+    var after = file.config!;
+    for (final dmcCommand in {for (final e in entries) e.dmcCommand}) {
+      after = planHookUninstall(after, location.agent, dmcCommand).after;
+    }
+    removed.addAll(entries);
+    writes.add((file, after));
+  }
+
+  final paths = root == null ? null : DmcPaths(basePath: root);
+  final watcherRunning = paths != null && await queryWatcher(paths) != null;
+
+  if (!json) {
+    print('[DMC] Disable: remove dmc\'s own agent hooks and stop the watcher');
+    print(
+      'Workspace: ${root ?? '(none here; only user-scope hooks are checked)'}',
+    );
+    if (removed.isEmpty) {
+      print('No dmc hooks found.');
+    }
+    for (final location in {for (final e in removed) e.location}) {
+      print(
+        '${location.agent.displayName} (${location.scope.name}): ${location.path}',
+      );
+      for (final entry in removed.where((e) => e.location == location)) {
+        print('  - ${entry.event}: ${entry.command}');
+      }
+      if (location.scope == HookScope.user) {
+        print(
+          '  Note: user-scope hooks serve every dmc workspace; removing them stops recording in all of them.',
+        );
+      }
+    }
+    print('Watcher: ${watcherRunning ? 'running' : 'not running'}');
+    print(
+      'Kept: ${root == null ? 'all history' : '${paths!.dmcDirectory.path} and every checkpoint'}, your code, and every other hook.',
+    );
+    for (final problem in problems) {
+      print('Warning: ${problem.message}');
+    }
+  }
+
+  var stopped = false;
+  var watcherExit = 0;
+  if (apply) {
+    for (final (file, after) in writes) {
+      final deleted = writeHookConfigFile(file, after);
+      if (!json) {
+        print(
+          deleted
+              ? '[DMC] Removed ${file.location.path}, which held only dmc hooks.'
+              : '[DMC] Wrote ${file.location.path}.',
+        );
+      }
+    }
+    if (watcherRunning) {
+      watcherExit = await stopDaemon(basePath: root);
+      stopped = watcherExit == 0;
+    }
+    if (!json) {
+      print(
+        removed.isEmpty && !watcherRunning
+            ? '[DMC] Nothing to disable.'
+            : '[DMC] Disabled. Turn recording back on with: dmc hooks install --agent <muse-code|claude-code> --apply',
+      );
+    }
+  } else if (!json) {
+    print(
+      removed.isEmpty && !watcherRunning
+          ? '[DMC] Nothing to disable.'
+          : '[DMC] Preview only. Run again with --apply to remove these hooks${watcherRunning ? ' and stop the watcher' : ''}.',
+    );
+  }
+
+  final exitCode = apply && watcherRunning && !stopped ? 1 : 0;
+  if (json) {
+    print(
+      CommandResult(
+        command: 'disable',
+        exitCode: exitCode,
+        data: {
+          'mode': apply ? 'apply' : 'preview',
+          'workspaceRoot': root,
+          'hooks': [for (final e in removed) e.toJson()],
+          'removedConfigFiles': [
+            if (apply)
+              for (final (file, after) in writes)
+                if (after.isEmpty) file.location.path,
+          ],
+          'watcher': {'running': watcherRunning, 'stopped': stopped},
+          'historyKept': true,
+        },
+        warnings: problems,
+        errors: [
+          if (exitCode != 0)
+            const MachineMessage(
+              'watcher_stop_failed',
+              'The watcher did not stop; run dmc stop, then dmc doctor.',
+            ),
+        ],
+      ).withWorkspace(root ?? cwd).encode(),
+    );
+  }
+  return exitCode;
+}
+
+int _fail(bool json, String cwd, String code, String message) {
+  if (json) {
+    print(
+      CommandResult(
+        command: 'disable',
+        exitCode: 1,
+        errors: [MachineMessage(code, message)],
+      ).withWorkspace(cwd).encode(),
+    );
+  } else {
+    print('[DMC] Error: $message');
+  }
+  return 1;
+}
