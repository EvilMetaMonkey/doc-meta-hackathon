+  /// Ignore-policy drift during a checkpoint: the close-time policy
+  /// fingerprint, and per-file scope changes. Nullable and additive; existing
+  /// rows are not rewritten.
+  void _migrateToVersion5() {
+    final checkpointColumns = {
+      for (final row in _db!.select('PRAGMA table_info(checkpoints)'))
+        row['name'] as String,
+    };
+    if (!checkpointColumns.contains('close_policy_fingerprint')) {
+      _db!.execute(
+        'ALTER TABLE checkpoints ADD COLUMN close_policy_fingerprint TEXT',
+      );
+    }
+    final fileColumns = {
+      for (final row in _db!.select('PRAGMA table_info(checkpoint_files)'))
+        row['name'] as String,
+    };
+    if (!fileColumns.contains('scope_change')) {
+      _db!.execute(
+        "ALTER TABLE checkpoint_files ADD COLUMN scope_change TEXT CHECK(scope_change IS NULL OR scope_change IN ('left_scope', 'entered_scope'))",
+      );
+    }
+  }
+
   /// Close the database connection
   void close() {
     _db?.close();
diff --git a/lib/src/ignore.dart b/lib/src/ignore.dart
index ee68910c73864143c2926deb748f0f401ae9492d..49286fc0b2f4d26d7633cac99c4f3f9517b40cc9 100644
--- a/lib/src/ignore.dart
+++ b/lib/src/ignore.dart
@@ -185,6 +185,26 @@ class IgnorePolicy {
 
   bool get gitMode => git != null;
 
+  /// The subset of [relativePaths] (native, relative to the workspace) that
+  /// this policy excludes: by DMC's rules, or, in Git mode, because Git
+  /// ignores them. Paths need not exist. One Git process at most.
+  Future<Set<String>> outOfScope(Iterable<String> relativePaths) async {
+    final paths = relativePaths.toList();
+    if (paths.isEmpty) return const {};
+    final excluded = {
+      for (final path in paths)
+        if (rules.any((rule) => rule.matches(path))) path,
+    };
+    if (git != null) {
+      excluded.addAll(
+        await git!.ignoredAmong(
+          paths.where((path) => !excluded.contains(path)),
+        ),
+      );
+    }
+    return excluded;
+  }
+
   /// A one-line description for status and doctor.
   String get description => git == null
       ? 'dmc rules (not a Git work tree)'
